module Timeout;

// BROKEN: Timeout, but on the right B sends C a2() instead of TOc().
// Which safety properties fail, and why? Then press Check, compare, and fix it.

global protocol Timeout(role A, role B, role C) {
    mixed {
        a1() from A to B;
        a2() from A to C;
        a3() from B to C;
        a4() from B to A;
        a5() from C to A;
    } or A -> B {
        TOa() from B to A;
        a2() from B to C;
    }
}
