module Timeout;

// BROKEN: Timeout, with B choosing between a4() and b4() on the left; C gets a3()
// either way.
// What fails, and why? Then press Check, compare, and fix it.

global protocol Timeout(role A, role B, role C) {
    mixed {
        a1() from A to B;
        a2() from A to C;
        choice at B {
            a4() from B to A;
            a3() from B to C;
            a5() from C to A;
        } or {
            b4() from B to A;
            a3() from B to C;
        }
    } or A -> B {
        TOa() from B to A;
        TOc() from B to C;
    }
}
