module Timeout;

// Exercise 3: from the correct Timeout to its state machines and its Erlang.
// Open the EFSM tab and pick B. Click a transition: its action lights up in B's
// local type, and its code shows below the diagram.
// B observes: it goes along with A (left) or times out (right).

global protocol Timeout(role A, role B, role C) {
    mixed {                       // left
        a1() from A to B;
        a2() from A to C;
        a3() from B to C;
        a4() from B to A;
        a5() from C to A;
    } or A -> B {                 // right: B overrules A
        TOa() from B to A;
        TOc() from B to C;
    }
}
