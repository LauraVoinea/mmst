module Quote;

// Figure 1's Timeout as a price quote; the Erlang mode's quote set runs it.
// Customer orders from Shop and gives Warehouse the postcode; Shop has Warehouse
// set the stock aside and quotes the price; Warehouse quotes the delivery.
// Shop observes: it goes along with Customer when the order comes in time (left),
// or gives up waiting, withdraws the quote and tells Warehouse (right).
//
// Figure 1:  A Customer, B Shop, C Warehouse;  a1 order, a2 address, a3 reserve,
//            a4 price, a5 delivery, TOa expired, TOc cancel.

data <erlang> "string()" from "rt.jar" as item;
data <erlang> "integer()" from "rt.jar" as qty;
data <erlang> "string()" from "rt.jar" as postcode;
data <erlang> "integer()" from "rt.jar" as pence;
data <erlang> "integer()" from "rt.jar" as days;

global protocol Quote(role Customer, role Shop, role Warehouse) {
    mixed {                       // left
        order(item, qty) from Customer to Shop;
        address(postcode) from Customer to Warehouse;
        reserve(item, qty) from Shop to Warehouse;
        price(pence) from Shop to Customer;
        delivery(days, pence) from Warehouse to Customer;
    } or Customer -> Shop {       // right: Shop overrules Customer
        expired() from Shop to Customer;
        cancel() from Shop to Warehouse;
    }
}
