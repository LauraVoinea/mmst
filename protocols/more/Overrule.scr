module Overrule;

// BROKEN. q may send a() to p; p, the observer, may overrule with c().
// What fails, and why? Then press Check, compare, and fix it.

global protocol Overrule(role p, role q, role r) {
    mixed {
        a() from q to p;
        b() from q to r;
        y() from p to r;
        z() from p to q;
    } or q -> p {
        c() from p to q;
        b() from q to r;
    }
}
