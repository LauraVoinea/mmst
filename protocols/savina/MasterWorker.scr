module MasterWorker;

// Savina's master and worker, as a mixed choice: Master sets several workers on
// the same work and needs only the first answer.
// Master observes: Worker reports its result (left), or Master cancels it once
// another worker has answered (right). Pool learns which.

global protocol MasterWorker(role Worker, role Master, role Pool) {
    assign() from Master to Worker;
    mixed {
        result() from Worker to Master;
        ack() from Master to Worker;
        stored() from Master to Pool;
    } or Worker -> Master {
        cancel() from Master to Worker;
        discarded() from Master to Pool;
    }
}
