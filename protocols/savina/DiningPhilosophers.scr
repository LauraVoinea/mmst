module DiningPhilosophers;

// Savina's dining philosophers, as a mixed choice.
// Philosopher observes: it takes the fork when Fork grants it (left), or gives
// up waiting (right). Neighbour, at the next seat, learns which.

global protocol DiningPhilosophers(role Philosopher, role Fork, role Neighbour) {
    request() from Philosopher to Fork;
    mixed {
        granted() from Fork to Philosopher;
        thanks() from Philosopher to Fork;
        eating() from Philosopher to Neighbour;
    } or Fork -> Philosopher {
        giveup() from Philosopher to Fork;
        skipped() from Philosopher to Neighbour;
    }
}
