module SleepingBarber;

// Savina's sleeping barber, as a mixed choice.
// Customer observes: Barber calls it in (left), or it leaves because the waiting
// room is full (right). Shop, the till, learns which.

global protocol SleepingBarber(role Customer, role Barber, role Shop) {
    arrive() from Customer to Barber;
    mixed {
        wake() from Barber to Customer;
        seated() from Customer to Barber;
        haircut() from Customer to Shop;
    } or Barber -> Customer {
        leave() from Customer to Barber;
        walkedOut() from Customer to Shop;
    }
}
